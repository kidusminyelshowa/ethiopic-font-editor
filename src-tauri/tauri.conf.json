{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ethiopic Font Editor",
  "version": "0.1.0",
  "identifier": "com.kidus.ethiopic-font-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ethiopic Font Editor",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNTg2MDM5QjEzMjNERjAKUldUd1BUS3hPV0JZekJSbTh2RkZzSGMrcEJFMDZZS2drLzRuMTZ3VDlwZ3J5Tnc4T1pKOXJPTDQK",
      "endpoints": [
        "https://github.com/kidusminyelshowa/ethiopic-font-editor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
